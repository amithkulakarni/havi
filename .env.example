# ==============================================================================
# LOCAL FREIGHT AUTOMATION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate with your local values.
# NEVER commit the '.env' file or hardcode credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM SETTINGS (No cloud credentials required)
# ------------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.80
SCANNED_CHAR_THRESHOLD=20
ENABLE_OCR_FALLBACK=true

# ------------------------------------------------------------------------------
# 2. AZURE AUTHENTICATION MODES: "managed_identity", "entra_id", "service_principal", or "api_key"
# ------------------------------------------------------------------------------
# For Azure AI Foundry Hosted Agents in production: use managed_identity
AZURE_AUTH_METHOD=managed_identity

# Optional User-Assigned Managed Identity Client ID (leave blank for System-Assigned)
# AZURE_CLIENT_ID=

# Automated Headless Service Principal (Entra ID - optional for local CI/CD)
# AZURE_TENANT_ID=your-azure-tenant-id
# AZURE_CLIENT_ID=your-azure-client-id
# AZURE_CLIENT_SECRET=your-azure-client-secret

# ------------------------------------------------------------------------------
# 3. AZURE AI FOUNDRY PROJECT & MODEL CONFIGURATION
# ------------------------------------------------------------------------------
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://havi-mcd-automation-resource.services.ai.azure.com/api/projects/havi-mcd-automation
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Optional Direct Endpoint / API-Key mode
# AZURE_OPENAI_ENDPOINT=https://havi-mcd-automation-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# ------------------------------------------------------------------------------
# 4. RUNTIME PATHS (Production Hosted Agent defaults to /tmp/havi_mcd)
# ------------------------------------------------------------------------------
RUNTIME_ROOT=/tmp/havi_mcd

# ------------------------------------------------------------------------------
# 4. AZURE BLOB STORAGE CONFIGURATION (Inbound PDFs & Document Retention)
# ------------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=havimcdstorage
AZURE_STORAGE_CONTAINER_NAME=shipment-documents
# AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string-here
